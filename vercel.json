{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "build": { "env": { "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0" } },
  "installCommand": "cd demo-showroom && npm install",
  "buildCommand": "cd demo-showroom && npm run build",
  "outputDirectory": "demo-showroom/dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
