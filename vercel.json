{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "build": { "env": { "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0" } },
  "installCommand": "corepack enable && cd demo-showroom && pnpm install --frozen-lockfile",
  "buildCommand": "cd demo-showroom && pnpm build",
  "outputDirectory": "demo-showroom/dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
