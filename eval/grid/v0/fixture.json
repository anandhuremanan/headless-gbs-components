{
  "$comment": "The grid every case in cases.jsonl is written against. Columns, authored semantics, policy and a small deterministic dataset, so a case can be checked end to end without a browser. Today is pinned to 2026-10-06 for relative-date cases.",
  "today": "2026-10-06",
  "locale": "en-IN",
  "getRowId": "id",
  "columns": [
    { "field": "id", "type": "number", "header": "ID" },
    { "field": "name", "header": "Customer" },
    { "field": "email", "header": "Email", "searchable": false },
    { "field": "region", "header": "Region" },
    { "field": "city", "header": "City" },
    {
      "field": "tier",
      "header": "Tier",
      "options": [
        { "label": "Platinum", "value": "platinum" },
        { "label": "Gold", "value": "gold" },
        { "label": "Silver", "value": "silver" },
        { "label": "Bronze", "value": "bronze" }
      ]
    },
    { "field": "revenue", "type": "number", "header": "Revenue" },
    { "field": "growth", "type": "number", "header": "Growth" },
    { "field": "churnRisk", "type": "number", "header": "Churn risk" },
    { "field": "signedUp", "type": "date", "header": "Signed up" },
    { "field": "active", "type": "boolean", "header": "Active" },
    { "field": "owner", "header": "Account manager" }
  ],
  "semantics": {
    "name": { "description": "Registered company name.", "synonyms": ["customer", "company", "client", "account"] },
    "email": { "description": "Primary billing contact.", "pii": true },
    "region": { "description": "Indian state the customer bills from.", "synonyms": ["state"] },
    "city": { "description": "City the customer bills from.", "synonyms": ["location", "branch"] },
    "tier": { "description": "Commercial tier agreed in the contract.", "synonyms": ["plan", "segment"] },
    "revenue": {
      "description": "Annual recurring revenue for the current contract year.",
      "unit": "INR",
      "higherIsBetter": true,
      "synonyms": ["arr", "sales", "turnover", "billing", "spend"]
    },
    "growth": {
      "description": "Year-on-year revenue growth, stored as a whole percentage.",
      "unit": "%",
      "percentBasis": "whole",
      "higherIsBetter": true,
      "synonyms": ["yoy", "growth rate"]
    },
    "churnRisk": {
      "description": "Modelled probability the customer leaves within a year, stored as a fraction.",
      "percentBasis": "fraction",
      "higherIsBetter": false,
      "synonyms": ["risk", "churn", "attrition"]
    },
    "signedUp": { "description": "Date the first contract was signed.", "synonyms": ["joined", "start date", "onboarded"] },
    "active": { "description": "Whether the contract is currently live.", "synonyms": ["live", "status"] },
    "owner": { "description": "Account manager responsible.", "synonyms": ["manager", "rep", "ae"] }
  },
  "policy": {
    "maxExportRows": 10000,
    "confirmExportRows": 25,
    "maxSelectRows": 20
  },
