# Copy to `.env` and fill in whichever tier you want to run.
# `.env` is gitignored. A real environment variable overrides anything here.

# Free, no credit card — aistudio.google.com. The recommended ceiling tier:
#   node tools/eval/grid/cli.cjs --model=ceiling --rpm=8 --concurrency=2
GOOGLE_API_KEY=

# Free, no credit card — console.groq.com. Lots of requests, tight token/minute cap.
GROQ_API_KEY=

# Free monthly credits — huggingface.co/settings/tokens. Reaches 200+ models.
HF_TOKEN=

# Free models capped per day — openrouter.ai/keys
OPENROUTER_API_KEY=

# Paid. No diagnostic advantage over the free options above.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local models through Ollama. Defaults to http://localhost:11434
# OLLAMA_HOST=
